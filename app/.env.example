# Copy this file to `.env.local` and fill it in. `.env.local` is ignored by git.
# On Vercel, add the same names under Project Settings -> Environment Variables, then redeploy
# (Vite bakes these values into the site when it builds).

# Required: your program ID. Solana Playground shows it after Build / Deploy
# (it is also the address inside declare_id!(...) after Playground rewrites it).
VITE_PROGRAM_ID=

# Optional: a devnet RPC URL. Defaults to the free public one, which allows about
# 100 requests per 10 seconds. If you use your own, keep the word "devnet" in the URL:
# wallets look for it to decide which network to send transactions to.
VITE_RPC_URL=https://api.devnet.solana.com
